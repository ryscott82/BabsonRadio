<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. Xcode signs App Store and TestFlight builds with "production" whatever this says. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- App Attest (Firebase App Check). "production" is also what Apple uses when the key is missing. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
	<!-- Universal links: the QR code on the studio door (babsonradio.com/booth/door) opens the app, which signs you in at the studio PC. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:babsonradio.com</string>
	</array>
</dict>
</plist>
