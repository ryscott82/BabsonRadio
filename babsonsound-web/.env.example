# Server-only secrets (add to .env.local and your hosting provider's env settings)

# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON on ONE line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Random secret, 16+ chars (e.g. `openssl rand -hex 32`). Keys the phone lookup index.
# Changing it later orphans existing index entries, so set it once and keep it.
PHONE_HASH_PEPPER=

# Yearly semester-end dates (MM-DD, comma-separated; they repeat every year) for the
# "until end of semester" guest option. Optional: defaults to 12-18,05-14.
SEMESTER_END_DATES=12-18,05-14

# Launch lock. Until the launch time only admins, directors and radio-trained students
# get in; everyone else can sign up but sees a waiting screen. The site opens by itself at LAUNCH_AT. No redeploy.
# Random secret, 16+ chars (openssl rand -hex 24). Signs launch passes and unsubscribe links. Keep it once emails go out:
# changing it breaks the unsubscribe links already sent.
LAUNCH_SECRET=
# Optional. ISO time the site opens. Default 2026-10-30T14:00:00Z (Oct 30, 10:00 am Eastern).
LAUNCH_AT=
# Optional manual override: 1 opens the site to everyone right now (redeploy to apply).
LAUNCH_OPEN=

# Owner accounts: comma-separated emails. They are always admin and cannot be demoted or changed by anyone else.
# Also the way to keep an admin whose email is not babson.edu, olin.edu or wellesley.edu.
OWNER_EMAILS=

# Auto-scheduler: Vercel Cron calls /api/cron/autoschedule daily with this secret.
# Create any long random string; Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Firebase Storage bucket for schedule pictures (defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET).
FIREBASE_STORAGE_BUCKET=

# AzuraCast (Asura): lets the auto-scheduler switch playlists on the station.
AZURACAST_URL=            # e.g. https://a12.asurahosting.com  (no trailing slash)
AZURACAST_API_KEY=        # "<id>:<secret>" from AzuraCast > your profile > API Keys
AZURACAST_STATION_ID=1    # station id or short name
RESEND_API_KEY=
MAIL_FROM=Babson Radio <hello@babsonradio.com>
MAIL_REPLY_TO=

# Local testing with the Firebase emulators (npm run emulators, npm run dev:emulated). Never set these in Vercel.
# NEXT_PUBLIC_USE_EMULATORS=1
