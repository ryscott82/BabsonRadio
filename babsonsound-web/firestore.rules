rules_version = '2';

// REVIEW BEFORE DEPLOYING: `firebase deploy --only firestore:rules` replaces whatever rules
// are currently live. Collections other than the ones below (shows, episodes, schedule,
// presence, users, guest*, connections) are denied by default — add any I didn't know about.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────
    function signedIn() { return request.auth != null; }

    // Verified @babson.edu, @olin.edu or @wellesley.edu address. (Firebase lowercases emails in the token.)
    function isBabson() {
      return signedIn()
        && (request.auth.token.email_verified == true
            || request.time.toMillis() < request.auth.token.get('graceUntil', 0))
        && (request.auth.token.email.matches('.*@(babson|olin|wellesley)\\.edu$')
            || request.auth.token.get('tester', false) == true
            || request.auth.token.get('openMember', false) == true); // public mode, see PUBLIC_MODE.md
    }

    // Developer accounts: created with scripts/create-developer.mjs (custom claim, no babson.edu email).
    function isDeveloper() {
      return signedIn() && request.auth.token.developer == true;
    }

    // Students and developers. Guests (trial or sponsored pass) get LIVE RADIO ONLY —
    // that is gated in the apps, because the stream itself is not in Firestore — and
    // never any stored content such as the episode backlog.
    function isMember() { return isBabson() || isDeveloper(); }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isStaff() {
      return isDeveloper() || (isBabson() && role() in ['superAdmin', 'showHost']);
    }
    function isAdmin() { return isDeveloper() || (isBabson() && role() == 'superAdmin'); }
    // Directors run show times and slot requests only.
    function isDirector() { return isAdmin() || (isBabson() && role() == 'director'); }

    // ── public ───────────────────────────────────────────────
    match /shows/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /schedule/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Episodes are students/developers only unless visibility == 'public', which only the server sets, after an adult host
    // signs the public-sharing agreement. A missing field means private.
    // NOTE: this protects the Firestore document (incl. its audioURL/youtubeID), not the
    // media file itself — private media would also need signed URLs / Storage rules.
    match /episodes/{id} {
      allow read: if resource.data.get('visibility', 'private') == 'public' || isMember();
      allow write: if isStaff();
    }

    // Server-only: /api/presence decides who may see whom (names only for connected contacts,
    // never for people in invisible mode). Clients can't read or write these directly.
    match /presence/{uid} {
      allow read, write: if false;
    }

    // Episode likes: server-only so "your friend liked this" can respect invisible mode.
    match /likes/{id} {
      allow read, write: if false;
    }

    // ── users ────────────────────────────────────────────────
    // Created by the server only (signup / guest routes). Owners may edit a few
    // harmless fields — never role, email, phone or hostOfShows.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'firstName', 'notifyNewEpisode', 'notifyGoesLive']);
      allow update: if isAdmin();
      allow delete: if false;

      // Contact-network edges: written by /api/contacts/match only.
      match /connections/{other} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ── guest access (all writes via server routes) ──────────
    match /guestTrials/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /guestPasses/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid
                      || resource.data.sponsorUid == request.auth.uid);
      allow write: if false;
    }
    match /guestRequests/{id} {
      allow read: if signedIn() && (resource.data.guestUid == request.auth.uid
                      || resource.data.sponsorUid == request.auth.uid);
      allow write: if false;
    }

    // ── on-air slots (all writes via server routes) ──────────
    // Approved bookings: any member can see what's taken.
    match /airSlots/{id} {
      allow read: if isMember();
      allow write: if false;
    }
    // Requests: the requester and staff can read; staff review them on /admin/slots.
    match /slotRequests/{id} {
      allow read: if signedIn() && (resource.data.requesterUid == request.auth.uid || isStaff() || isDirector());
      allow write: if false;
    }

    // Server-only: phone lookup index, pending invites, sync rate limits.
    match /phoneIndex/{id}    { allow read, write: if false; }
    match /guestInvites/{id}  { allow read, write: if false; }
    match /contactSyncs/{id}  { allow read, write: if false; }
    match /contactGraph/{id}  { allow read, write: if false; }
    match /contactPopularity/{id} { allow read, write: if false; }
    // Auto-scheduler settings and generated filler blocks: server only (served via /api routes).
    match /config/{id}        { allow read, write: if false; }
    match /feedback/{id}      { allow read, write: if false; }
    match /autoBlocks/{id}    { allow read, write: if false; }
    match /songVotes/{id}     { allow read, write: if false; }
    match /voteOverrides/{id} { allow read, write: if false; }
    match /voteThresholds/{id} { allow read, write: if false; }
    match /songRequests/{id}  { allow read, write: if false; }
    match /playlistRequests/{id} { allow read, write: if false; }
    match /autoActual/{id}    { allow read, write: if false; }
    match /liveRequests/{id}  { allow read, write: if false; }
    match /skipVotes/{id}     { allow read, write: if false; }
    match /broadcasts/{id}    { allow read, write: if false; }
  }
}
