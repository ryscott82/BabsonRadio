rules_version = '2';

// REVIEW BEFORE DEPLOYING: `firebase deploy --only firestore:rules` replaces whatever rules
// are currently live. Collections other than the ones below (shows, episodes, schedule,
// presence, users, guest*, connections) are denied by default — add any I didn't know about.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────
    function signedIn() { return request.auth != null; }

    // One access level per person, stored on users/{uid}.level: guest | student | director | admin. Only the server writes it
    // (and the badges studioTrained / radioTrained, and unsubscribed). The hidden App Store reviewer account has demo == true.
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function level() { return me().get('level', 'guest'); }

    // Verified @babson.edu, @olin.edu or @wellesley.edu address, or still inside the 7-day sign-up grace.
    // Exact domains only: students.babson.edu does not match. (Firebase lowercases emails in the token.)
    function schoolVerified() {
      return signedIn()
        && (request.auth.token.email_verified == true
            || request.time.toMillis() < request.auth.token.get('graceUntil', 0))
        && request.auth.token.email.matches('.*@(babson|olin|wellesley)\\.edu$');
    }

    // Students and above. Guests get LIVE RADIO ONLY: that is gated by the server, because the stream itself is
    // not in Firestore, and guests never read stored content such as the episode backlog.
    function isStudent() {
      return signedIn() && level() in ['student', 'director', 'admin']
        && (schoolVerified() || request.auth.token.email_verified == true || me().get('demo', false) == true);
    }
    function isMember() { return isStudent(); }
    function isAdmin() { return isStudent() && level() == 'admin'; }
    function isStaff() { return isAdmin(); }
    // Directors run show times and slot requests; admins can do everything directors can.
    function isDirector() { return isStudent() && level() in ['director', 'admin']; }

    // The studio PC's library worker signs in with a custom token (uid studio-worker, claim worker: true, minted by POST /api/worker/token).
    // Its session counts for one hour after sign-in (auth_time) plus 5 minutes of slack, so a stolen refresh token stops working.
    function isWorker() {
      return signedIn() && request.auth.uid == 'studio-worker' && request.auth.token.get('worker', false) == true
        && request.auth.token.get('auth_time', 0) * 1000 > request.time.toMillis() - 3900000;
    }

    // ── public ───────────────────────────────────────────────
    match /shows/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /schedule/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Episodes are students and above only unless visibility == 'public', which only the server sets, after an adult host
    // signs the public-sharing agreement. A missing field means private.
    // NOTE: this protects the Firestore document (incl. its audioURL/youtubeID), not the
    // media file itself — private media would also need signed URLs / Storage rules.
    match /episodes/{id} {
      allow read: if resource.data.get('visibility', 'private') == 'public' || isMember();
      allow write: if isStaff();
    }

    // Server-only: /api/presence decides who may see whom (names only for connected contacts,
    // never for people in invisible mode). Clients can't read or write these directly.
    match /presence/{uid} {
      allow read, write: if false;
    }

    // Pushed live tallies (skip votes, hour vote, set list of what is on air). The server writes it (at most once every 45 s, only when
    // something changed); every signed-in page may read it, and nobody can write it. It holds no listener count and no names.
    match /liveState/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Server-time log, alerts and tier changes: admin pages read these through the API only.
    match /serverUsage/{id} { allow read, write: if false; }
    match /usageAlerts/{id} { allow read, write: if false; }
    match /cpuTierLog/{id} { allow read, write: if false; }
    match /settingsLog/{id} { allow read, write: if false; }

    // Episode likes: server-only so "your friend liked this" can respect invisible mode.
    match /likes/{id} {
      allow read, write: if false;
    }

    // ── users ────────────────────────────────────────────────
    // Created by the server only (signup / guest routes). Owners may edit a few
    // harmless fields: never level, badges, email or phone.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if false;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['notifyNewEpisode', 'notifyGoesLive']); // names change through /api/me, which runs the word filter
      // Admins edit people through the server (/api/admin/users). Never from a client: level, badges and the
      // unsubscribe flag are server-only, so nobody can write their own.
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['level', 'role', 'studioTrained', 'radioTrained', 'unsubscribed', 'unsubscribedAt', 'demo', 'email',
                       'phoneEncrypted', 'phoneHash', 'phoneVerified', 'phoneNumber']);
      allow delete: if false;

      // Contact-network edges: written by /api/contacts/match only.
      match /connections/{other} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ── on-air slots (all writes via server routes) ──────────
    // Approved bookings: any member can see what's taken.
    match /airSlots/{id} {
      allow read: if isMember();
      allow write: if false;
    }
    // Requests: the requester and staff can read; staff review them on /admin/slots.
    match /slotRequests/{id} {
      allow read: if signedIn() && (resource.data.requesterUid == request.auth.uid || isStaff() || isDirector());
      allow write: if false;
    }

    // Server-only: phone lookup index, pending invites, sync rate limits.
    match /phoneIndex/{id}    { allow read, write: if false; }
    match /contactSyncs/{id}  { allow read, write: if false; }
    match /contactGraph/{id}  { allow read, write: if false; }
    match /contactPopularity/{id} { allow read, write: if false; }
    // Auto-scheduler settings and generated filler blocks: server only (served via /api routes).
    match /config/{id}        { allow read, write: if false; }
    // Studio PC sign-in log (server only).
    match /boothSessions/{id} { allow read, write: if false; }
    match /boothEvents/{id}   { allow read, write: if false; }
    match /boothNowPlaying/{id} { allow read, write: if false; }
    match /boothNotes/{id}    { allow read, write: if false; }
    match /feedback/{id}      { allow read, write: if false; }
    match /autoBlocks/{id}    { allow read, write: if false; }
    match /songVotes/{id}     { allow read, write: if false; }
    match /voteOverrides/{id} { allow read, write: if false; }
    match /voteThresholds/{id} { allow read, write: if false; }
    match /songRequests/{id}  { allow read, write: if false; }
    match /playlistRequests/{id} { allow read, write: if false; }
    match /autoActual/{id}    { allow read, write: if false; }
    match /liveRequests/{id}  { allow read, write: if false; }
    match /skipVotes/{id}     { allow read, write: if false; }
    match /broadcasts/{id}    { allow read, write: if false; }
    // Launch email state (launchEmail/{sha256(email)} sent markers, launchEmail/_run) and failure log, listening-hour budget, one-device sessions, phone change requests, host training.
    // (Anything not listed is denied anyway; these lines just say so.)
    match /roleInvites/{id}          { allow read, write: if false; } // roles saved for emails with no account yet
    match /launchEmail/{id}          { allow read, write: if false; }
    match /launchEmailFailures/{id}  { allow read, write: if false; }
    match /usage/{id}                { allow read, write: if false; }
    match /usageHours/{id}           { allow read, write: if false; }
    match /listenGuard/{id}          { allow read, write: if false; }
    match /listenDays/{id}           { allow read, write: if false; }
    match /phoneChanges/{id}         { allow read, write: if false; }
    match /training/{id}             { allow read, write: if false; }
    match /noticeLog/{id}            { allow read, write: if false; } // dismissed admin notifications (the log)
    match /accountDeletions/{id}     { allow read, write: if false; } // who deleted which account, and why
    match /phoneLookups/{id}         { allow read, write: if false; } // every admin phone-number lookup (who, last 4 digits, found or not, when)
    match /signupIp/{id}             { allow read, write: if false; } // sign-up limit counters (keyed IP hash, TTL on expireAt)
    match /signupDomain/{id}         { allow read, write: if false; }
    match /signupGlobal/{id}         { allow read, write: if false; }
    // Studio training (admin SDK only): sessions with check-in secrets, attendance, append-only badge grants, club interest, check-in tries and logs, expiry notices
    match /trainingSessions/{id}     { allow read, write: if false; }
    match /trainingAttendance/{id}   { allow read, write: if false; }
    match /trainingGrants/{id}       { allow read, write: if false; }
    match /clubInterest/{id}         { allow read, write: if false; }
    match /trainingCheckinGuard/{id} { allow read, write: if false; } // 5 tries a minute, 15-minute lock (TTL on expireAt)
    match /trainingCheckinLog/{id}   { allow read, write: if false; } // wrong codes and locks (TTL on expireAt)
    match /trainingNotices/{id}      { allow read, write: if false; }
    match /instagramClears/{id}      { allow read, write: if false; } // which admin cleared which Instagram handle, and when

    // ── library worker (studio PC) ───────────────────────────
    // Jobs are created by the API only (/api/admin/library/jobs), never from a client. The worker can read them and update progress and the final state;
    // it can not queue, cancel or delete a job. Admins read these three collections; everything else goes through the API.
    match /workerJobs/{id} {
      allow read: if isWorker() || isAdmin();
      allow create, delete: if false;
      allow update: if isWorker()
        && resource.data.status in ['queued', 'running']
        && request.resource.data.status in ['running', 'done', 'failed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'startedAt', 'finishedAt', 'progress', 'error']);
    }
    // Proposals come from the worker (always pending). Only the API (an admin approving) can make one approved or rejected; the worker can
    // then only mark an approved one applied or failed, and can not change what it would write.
    match /workerProposals/{id} {
      allow read: if isWorker() || isAdmin();
      allow create: if isWorker() && request.resource.data.status == 'pending' && request.resource.data.songId == id;
      allow update: if isWorker() && request.resource.data.songId == resource.data.songId && (
        (resource.data.status == 'approved' && request.resource.data.status in ['applied', 'failed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'error']))
        || (resource.data.status in ['pending', 'failed', 'applied'] && request.resource.data.status == 'pending')
        || (resource.data.status == 'rejected' && request.resource.data.status == 'rejected'));
      allow delete: if isWorker() && resource.data.status != 'approved';
    }
    match /workerStatus/{id} {
      allow read: if isWorker() || isAdmin();
      allow write: if isWorker();
    }
    // Append-only change log of every AzuraCast change (written by the API from the worker's reports), and the stored beats: server only.
    // Studio bookings, strikes, recordings, club events, past-guest lists and the popular-times summary: server only (guest names and emails stay private).
    match /studioBookings/{id}       { allow read, write: if false; }
    match /strikes/{id}              { allow read, write: if false; }
    match /recordings/{id}           { allow read, write: if false; }
    match /clubEvents/{id}           { allow read, write: if false; }
    match /guestHistory/{id}         { allow read, write: if false; }
    match /popularTimes/{id}         { allow read, write: if false; }
    match /libraryChanges/{id}       { allow read, write: if false; }
    match /libraryBeats/{id}         { allow read, write: if false; }
  }
}
