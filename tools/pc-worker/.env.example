# Studio PC worker settings. Copy to .env (same folder) and fill in. Never commit .env.
# Only the service account that runs the worker should be able to read this file (see README).

# ── Website ──
SITE_URL=https://babsonradio.com
# Same value as WORKER_SECRET in Vercel (32+ random characters).
WORKER_SECRET=

# ── Firebase (public web-app values, the same ones the website uses: NEXT_PUBLIC_FIREBASE_*) ──
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# ── AzuraCast ──
AZURACAST_URL=https://a12.asurahosting.com
AZURACAST_STATION=babson_radio
# A key for an AzuraCast user whose role can ONLY manage this station's media (not broadcasting, not settings).
AZURACAST_API_KEY=

# ── Safety switches ──
# 1 = library.apply / library.undo really change AzuraCast. Leave 0 (dry run) until the --limit 3 test has passed.
ALLOW_APPLY=0
# Every job handles at most this many songs. Use 3 for the first test, then set 0 (no limit).
JOB_LIMIT=3

# ── Optional ──
# PYTHON=py                       Windows launcher (default). Or a full path to python.exe.
# TOOLS_DIR=C:\BabsonRadio\tools   default: the folder above this one
# HELPER_URL=http://127.0.0.1:7781 the studio helper (to see if BUTT is live)
# TARGET_LUFS=-14
# AZ_MIN_INTERVAL=1.0              seconds between AzuraCast calls
# LOG_DEBUG=1                      also print debug lines to the console
