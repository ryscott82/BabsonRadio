# Copy to .env and fill in. Never commit .env.

# Same value as STUDIO_PC_SECRET in Vercel (32+ random characters).
STUDIO_PC_SECRET=

# Where butt.exe is (default shown).
BUTT_PATH=C:\Program Files\butt\butt.exe

# BUTT's command port (BUTT's default is 1256). Leave BUTT's "accessible from network" option OFF.
BUTT_COMMAND_PORT=1256

# Name of the saved server in BUTT that points at the station's live DJ port. Blank = BUTT's current server.
BUTT_SERVER_NAME=

# 1 = also record each show to BUTT's recording folder.
RECORD_SHOWS=0

# Only for testing the page on a dev laptop (npm run dev). Leave 0 on the studio PC.
ALLOW_LOCALHOST=0
