# Copy to .env and fill in. Never commit .env.

# Same value as STUDIO_PC_SECRET in Vercel (32+ random characters).
STUDIO_PC_SECRET=

# Where butt.exe is (default shown).
BUTT_PATH=C:\Program Files\butt\butt.exe

# BUTT's command port (BUTT's default is 1256). Leave BUTT's "accessible from network" option OFF.
BUTT_COMMAND_PORT=1256

# Name of the saved server in BUTT that points at the station's live DJ port. Blank = BUTT's current server.
BUTT_SERVER_NAME=


# Only for testing the page on a dev laptop (npm run dev). Leave 0 on the studio PC.
ALLOW_LOCALHOST=0

# Station music library for background music (optional). Make an AzuraCast user with only
# "Manage station media" on this station, create an API key for it, and put it here.
AZURACAST_URL=https://a12.asurahosting.com
AZURACAST_API_KEY=
AZURACAST_STATION_ID=1
# Playlists (names, comma separated) the go-live page uses. Turn these playlists off in AzuraCast so auto-play skips them.
BED_PLAYLISTS=Beds,Podcast beds,Background
ID_PLAYLISTS=Station IDs,Sweepers
SOUNDBOARD_PLAYLISTS=Soundboard,Jingles,Sound effects
AD_PLAYLISTS=Ads,Advertisements,PSAs

# Auto level (optional). Install loopMIDI, make a port (default name "loopMIDI Port"), run "npm install" here,
# then in BUTT: Settings → MIDI, pick that port and map this CC on this channel to "Master Gain" (absolute, soft takeover off).
MIDI_PORT=loopMIDI
MIDI_CHANNEL=1
MIDI_GAIN_CC=7

# Every show is recorded in BUTT. Set to 0 to stop that.
RECORD_SHOWS=1

# ── Record a show ──
# The website the helper tells when an upload is done (signed with STUDIO_PC_SECRET, like the sign-in).
SITE_URL=https://babsonradio.com
# Where recordings are kept until they are uploaded and confirmed (then 7 more days). Default: the "recordings" folder here.
# Must be on a drive with room for several hours of audio. BUTT's own record folder can be anywhere; files are moved here.
RECORDINGS_DIR=
# AzuraCast folder the recordings go into (uses AZURACAST_URL / AZURACAST_API_KEY / AZURACAST_STATION_ID above).
UPLOAD_FOLDER=Student recordings
# Uploads wait while a show is live from this PC, so they never take the stream's bandwidth. 1 = upload anyway.
UPLOAD_WHILE_LIVE=0
# ffmpeg joins paused pieces (no re-encoding) and ffprobe reads the length. Leave blank if both are on the system Path.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional: even out each recording's loudness after it is uploaded, with the PC worker's tool (tools/normalize_loudness.py, low priority,
# never while live). Needs Python and the tools folder next to this one (or TOOLS_DIR). It sets AzuraCast's "Amplify"; the file is not changed.
NORMALIZE_RECORDINGS=0
TOOLS_DIR=
PYTHON=
# AzuraCast station short name for the Python tool (defaults to AZURACAST_STATION_ID).
AZURACAST_STATION=babson_radio
